From 2045f953d90839b3a0f4f6c9c7cd2badf60048a0 Mon Sep 17 00:00:00 2001
From: Lauri Ojansivu <x@xet7.org>
Date: Fri, 13 Nov 2026 23:41:30 +0200
Subject: [PATCH] [SHELLBTRFS] Add Finnish (fi-FI) translation

Problem: The Btrfs pages of Explorer - properties, balance, scrub,
devices, send and receive - were in English on a Finnish system.

Why: shellbtrfs.rc, as WinBtrfs has it, carries only English (United
Kingdom) and no lang/ files.

How: Translate its dialogs and string tables into lang/fi-FI.rc with
the same ids, controls and printf inserts; API names, RAID levels and
compression names stay as they are. Include it under LANGUAGE_FI_FI
with the UTF-8 code page.
---
 dll/shellext/shellbtrfs/lang/fi-FI.rc | 571 ++++++++++++++++++++++++++
 dll/shellext/shellbtrfs/shellbtrfs.rc |   5 +
 2 files changed, 576 insertions(+)
 create mode 100644 dll/shellext/shellbtrfs/lang/fi-FI.rc

diff --git a/dll/shellext/shellbtrfs/lang/fi-FI.rc b/dll/shellext/shellbtrfs/lang/fi-FI.rc
new file mode 100644
index 00000000000..a8c78a69e27
--- /dev/null
+++ b/dll/shellext/shellbtrfs/lang/fi-FI.rc
@@ -0,0 +1,571 @@
+/*
+ * PROJECT:     WinBtrfs shell extension
+ * LICENSE:     LGPL-3.0-or-later (https://spdx.org/licenses/LGPL-3.0-or-later)
+ * PURPOSE:     Finnish resource file, the dialogs and strings of shellbtrfs.rc
+ * TRANSLATOR:  Copyright 2026 Lauri Ojansivu <x@xet7.org>
+ */
+
+LANGUAGE LANG_FINNISH, SUBLANG_DEFAULT
+
+IDD_PROP_SHEET DIALOGEX 0, 0, 235, 271
+STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD | WS_DISABLED | WS_CAPTION
+CAPTION "Inoden ominaisuussivu"
+FONT 8, "MS Shell Dlg", 400, 0, 0x0
+BEGIN
+    LTEXT           "Alitaltio:",IDC_STATIC,14,21,38,8
+    LTEXT           "Inode:",IDC_STATIC,14,35,21,8
+    GROUPBOX        "Tietoja",IDC_GROUP_INFORMATION,7,7,221,99
+    LTEXT           "Tyyppi:",IDC_STATIC,14,49,18,8
+    GROUPBOX        "POSIX-käyttöoikeudet",IDC_STATIC,7,110,221,102
+    LTEXT           "Käyttäjä:",IDC_STATIC,14,125,17,8
+    LTEXT           "Ryhmä:",IDC_STATIC,14,141,22,8
+    EDITTEXT        IDC_UID,94,123,40,14,ES_AUTOHSCROLL | ES_NUMBER
+    EDITTEXT        IDC_GID,94,139,40,14,ES_AUTOHSCROLL | ES_NUMBER
+    LTEXT           "Käyttäjä",IDC_STATIC,14,175,15,8
+    LTEXT           "Ryhmä",IDC_STATIC,14,186,20,8
+    LTEXT           "Muut",IDC_STATIC,14,196,22,8
+    LTEXT           "Luku",IDC_STATIC,50,162,17,8
+    LTEXT           "Kirjoitus",IDC_STATIC,89,162,18,8
+    LTEXT           "Suoritus",IDC_STATIC,129,162,30,8
+    CONTROL         "",IDC_USERR,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,54,175,16,10
+    CONTROL         "",IDC_GROUPR,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,54,186,16,10
