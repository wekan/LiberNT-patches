From 13509054a29648bac6574d078a536277d2b29196 Mon Sep 17 00:00:00 2001
From: Lauri Ojansivu <x@xet7.org>
Date: Fri, 13 Nov 2026 23:36:58 +0200
Subject: [PATCH] [JOY][WINMM] Add Finnish (fi-FI) translation

Problem: The Game Controllers control panel and the multimedia errors
of winmm, which every MCI and wave program shows, were in English on a
Finnish system.

Why: joy.rc and winmm.rc carry their English resources themselves, as
Wine has them, and include none of the lang/ files beside them; those
are older and no longer built.

How: Translate the English block of joy.rc into lang/fi-FI.rc and the
string table of winmm.rc into lang/winmm_Fi.rc, with the same ids,
controls and %-free texts, and include each under LANGUAGE_FI_FI with
the UTF-8 code page.
---
 dll/cpl/joy/joy.rc               |   5 ++
 dll/cpl/joy/lang/fi-FI.rc        | 108 +++++++++++++++++++++++++++
 dll/win32/winmm/lang/winmm_Fi.rc | 124 +++++++++++++++++++++++++++++++
 dll/win32/winmm/winmm.rc         |   5 ++
 4 files changed, 242 insertions(+)
 create mode 100644 dll/cpl/joy/lang/fi-FI.rc
 create mode 100644 dll/win32/winmm/lang/winmm_Fi.rc

diff --git a/dll/cpl/joy/joy.rc b/dll/cpl/joy/joy.rc
index ec579115dc2..03b1db9c49b 100644
--- a/dll/cpl/joy/joy.rc
+++ b/dll/cpl/joy/joy.rc
@@ -125,6 +125,11 @@ FONT 8, "Ms Shell Dlg"
     AUTOCHECKBOX    "Rumble", IDC_WGI_RUMBLE, 260, 30, 40, 10
 }
 
+#ifdef LANGUAGE_FI_FI
+#pragma code_page(65001)
+    #include "lang/fi-FI.rc"
+#endif
+
 LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
 
 /* @makedep: joy.manifest */
diff --git a/dll/cpl/joy/lang/fi-FI.rc b/dll/cpl/joy/lang/fi-FI.rc
new file mode 100644
index 00000000000..0ce12cdf4b9
--- /dev/null
+++ b/dll/cpl/joy/lang/fi-FI.rc
@@ -0,0 +1,108 @@
