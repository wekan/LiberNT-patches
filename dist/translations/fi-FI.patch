diff --git a/base/applications/cmdutils/find/lang/fi-FI.rc b/base/applications/cmdutils/find/lang/fi-FI.rc
new file mode 100644
index 00000000000..6d8658e32c5
--- /dev/null
+++ b/base/applications/cmdutils/find/lang/fi-FI.rc
@@ -0,0 +1,15 @@
+LANGUAGE LANG_FINNISH, SUBLANG_DEFAULT
+
+STRINGTABLE
+BEGIN
+    IDS_USAGE "FIND: Tulostaa tiedoston kaikki rivit, jotka sisältävät merkkijonon.\n\n\
+FIND [/V] [/C] [/N] [/I] [/OFF[LINE]] ""merkkijono"" [tiedosto...]\n\
+  /V         Tulostaa rivit, jotka eivät sisällä merkkijonoa.\n\
