From 8f3255a6f62ed2c713e9fd56b86d651af91459f7 Mon Sep 17 00:00:00 2001
From: Lauri Ojansivu <x@xet7.org>
Date: Fri, 13 Nov 2026 22:16:17 +0200
Subject: [PATCH 1/4] [TRANSLATION] Add Finnish (fi-FI) to the DiskPart, RAPPS
 and boot message tables

Problem: DiskPart's command help, RAPPS's install messages and the boot
manager's messages had no Finnish, so a Finnish LiberNT showed them in
English.

Why: The message tables are the last part of these programs' text.

How: Add Finnish=0x40B to each table's LanguageNames and a Finnish block
to every message, with the same inserts as the English; command names,
parameters and examples stay as they are typed. The tables compile with
windmc, giving a MSG0040B binary each.
---
 base/applications/rapps/rappsmsg.mc  |    9 +-
 base/system/diskpart/diskpart_msg.mc | 1020 ++++++++++++++++++++++++++
 sdk/include/reactos/mc/bootmsg.mc    |   12 +-
 3 files changed, 1039 insertions(+), 2 deletions(-)

diff --git a/base/applications/rapps/rappsmsg.mc b/base/applications/rapps/rappsmsg.mc
index 4681eeeacae..c6344041820 100644
--- a/base/applications/rapps/rappsmsg.mc
+++ b/base/applications/rapps/rappsmsg.mc
@@ -9,7 +9,8 @@ FacilityNames=(System=0x0:FACILITY_SYSTEM)
 
 LanguageNames=(English=0x409:MSG00409
                Polish=0x415:MSG00415
-               Romanian=0x418:MSG00418)
+               Romanian=0x418:MSG00418
+               Finnish=0x40B:MSG0040B)
 
 MessageId=1
 Severity=Success
@@ -24,6 +25,9 @@ Wywołano instalację programu "%1".
 Language=Romanian
 Este apelată instalarea programului "%1".
 .
+Language=Finnish
+Ohjelman "%1" asennus on käynnistetty.
+.
 
 MessageId=2
 Severity=Success
@@ -38,4 +42,7 @@ Wywołano usunięcie programu "%1".
 Language=Romanian
 Este apelată îndepărtarea programului "%1".
 .
+Language=Finnish
+Ohjelman "%1" poisto on käynnistetty.
+.
 
diff --git a/base/system/diskpart/diskpart_msg.mc b/base/system/diskpart/diskpart_msg.mc
index e47dcf602f4..7df6229988a 100644
--- a/base/system/diskpart/diskpart_msg.mc
+++ b/base/system/diskpart/diskpart_msg.mc
@@ -20,6 +20,7 @@ LanguageNames=(English=0x409:MSG00409
                Turkish=0x41F:MSG0041F
                Chinese=0x804:MSG00804
                Taiwanese=0x404:MSG00404
+               Finnish=0x40B:MSG0040B
               )
 
 
@@ -267,6 +268,29 @@ Language=Taiwanese
 
