From 434073684775461115dd77b7d876860a8329f509 Mon Sep 17 00:00:00 2001
From: Lauri Ojansivu <x@xet7.org>
Date: Fri, 13 Nov 2026 23:29:31 +0200
Subject: [PATCH] [GETUNAME] Add Finnish (fi-FI) Unicode character names

Problem: Character Map and the other users of getuname.dll showed the
37,966 Unicode character names in English on a Finnish system.

Why: getuname had no Finnish file, and its .rc only includes the
languages it lists.

How: Add lang/fi-FI.rc with every name of en-US.rc, by the same ids, and
include it under LANGUAGE_FI_FI. The names use the terms of Finnish
typography - akuutti, gravis, treema, hattu, sedilji, makron - and keep
a letter's own name as written: "Latinalainen iso kirjain A, jossa
akuutti", "Hangul-tavu Ga", "Oikealle osoittava nuoli". The empty names
of en-US.rc stay empty.
---
 dll/win32/getuname/getuname.rc   |     3 +
 dll/win32/getuname/lang/fi-FI.rc | 37979 +++++++++++++++++++++++++++++
 2 files changed, 37982 insertions(+)
 create mode 100644 dll/win32/getuname/lang/fi-FI.rc

diff --git a/dll/win32/getuname/getuname.rc b/dll/win32/getuname/getuname.rc
index a326803e90e..c60f4adf9d9 100644
--- a/dll/win32/getuname/getuname.rc
+++ b/dll/win32/getuname/getuname.rc
@@ -19,6 +19,9 @@
 #ifdef LANGUAGE_EN_US
     #include "lang/en-US.rc"
 #endif
+#ifdef LANGUAGE_FI_FI
+    #include "lang/fi-FI.rc"
+#endif
 #ifdef LANGUAGE_FR_FR
     #include "lang/fr-FR.rc"
 #endif
diff --git a/dll/win32/getuname/lang/fi-FI.rc b/dll/win32/getuname/lang/fi-FI.rc
new file mode 100644
index 00000000000..a43caade684
--- /dev/null
+++ b/dll/win32/getuname/lang/fi-FI.rc
@@ -0,0 +1,37979 @@
